<?xml version="1.0" ?>
<robot name="ackerman" xmlns:xacro="http://ros.org">

<xacro:include filename="$(find ackerman_description)/urdf/materials.xacro" />
<xacro:include filename="$(find ackerman_description)/urdf/ackerman.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <mass value="1.8"/>
    <inertia ixx="0.01" iyy="0.02" izz="0.025" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="sensor_1">
  <inertial>
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.04 0.0 -0.07" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/sensor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<link name="camara_1">
  <inertial>
    <origin xyz="-0.03 0.0 0.01" rpy="0 0 0"/>
    <mass value="0.05"/>
    <inertia ixx="0.00005" iyy="0.00005" izz="0.00005" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.15 0.0 -0.05" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/camara_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
</link>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.04 0.0 0.07" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="sensor_1"/>
</joint>

<joint name="camera_joint" type="fixed">
  <origin xyz="0.15 0.0 0.05" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camara_1"/>
</joint>

<link name="der_atras_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.0001" iyy="0.0002" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.12 0.12 -0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/der_atras_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="right_back_joint" type="continuous">
  <origin xyz="-0.12 -0.12 0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="der_atras_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<link name="izq_atras_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.0001" iyy="0.0002" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.12 -0.12 -0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/izq_atras_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="left_back_joint" type="continuous">
  <origin xyz="-0.12 0.12 0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="izq_atras_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<link name="front_right_steering_link">
  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
  </inertial>
</link>

<joint name="right_steering_joint" type="revolute">
  <origin xyz="0.12 -0.12 0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_right_steering_link"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
</joint>

<link name="der_delante_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.0001" iyy="0.0002" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.12 0.12 -0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/der_delante_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="right_top_joint" type="continuous">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="front_right_steering_link"/>
  <child link="der_delante_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<link name="front_left_steering_link">
  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
  </inertial>
</link>

<joint name="left_steering_joint" type="revolute">
  <origin xyz="0.12 0.12 0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_left_steering_link"/>
  <axis xyz="0 0 1"/>
  <limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
</joint>

<link name="izq_adelante_1">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <mass value="0.2"/>
    <inertia ixx="0.0001" iyy="0.0002" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.12 -0.12 -0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ackerman_description)/meshes/izq_adelante_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="left_top_joint" type="continuous">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="front_left_steering_link"/>
  <child link="izq_adelante_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

</robot>
